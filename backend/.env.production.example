APP_NAME="Deep Pockets"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://deepocket.my.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=regain
DB_USERNAME=regain_user
DB_PASSWORD=GANTI_PASSWORD_KUAT

# dipakai oleh container mysql (docker-compose.prod.yml membaca dari file .env di folder infrastructure/)
MYSQL_ROOT_PASSWORD=GANTI_ROOT_PASSWORD_KUAT

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=database
QUEUE_CONNECTION=redis
CACHE_STORE=redis

CORS_ALLOWED_ORIGINS=https://deepocket.my.id

VAPID_SUBJECT=mailto:emailmu@contoh.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
